# ════════════════════════════════════════════════════════════════
# GeneticGrid 环境变量配置
# ════════════════════════════════════════════════════════════════

# --- Django 基础配置 ---
DJANGO_SECRET_KEY=change-me-to-a-secure-key
ALLOWED_HOSTS=127.0.0.1,localhost

# --- 数据库配置（PostgreSQL + TimescaleDB） ---
# 容器内使用服务名 timescaledb，本地开发使用 localhost
DATABASE_URL=postgres://geneticgrid:geneticgrid@timescaledb:5432/geneticgrid
#
# K 线数据保留天数（超过此天数的历史数据将被自动清理）
# 设为 -1 表示永久保留
DB_RETENTION_DAYS=30

# --- 实时采集配置 ---
REALTIME_INGESTION_AUTO_START=true
REALTIME_INGESTION_STREAMS='[{"source":"okx","symbol":"BTCUSDT","bar":"1s"},{"source":"okx","symbol":"BTCUSDT","bar":"1m"},{"source":"okx","symbol":"ETHUSDT","bar":"1s"},{"source":"okx","symbol":"ETHUSDT","bar":"1m"}]'

# --- Redis 缓存（默认启用，大幅减轻数据库写入压力） ---
REDIS_CACHE_ENABLED=true
REDIS_CACHE_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_TTL_SECONDS=86400
REDIS_CACHE_MAX_ENTRIES=5000
